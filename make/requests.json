{
  "notes": "Body templates for two scenarios; these are not an importable blueprint. S2 runs its five HTTP modules in this order, with the live-mode filter after context. Map numeric generation from the context response. Configure Authorization privately.",
  "S1_instant_fulfillment": {
    "action": "webhook",
    "demo_id": "{{webhook.demo_id}}",
    "generation": "{{webhook.generation: map as a JSON number}}",
    "type": "{{webhook.type}}",
    "event_id": "{{webhook.event_id}}",
    "order_id": "{{webhook.order_id}}"
  },
  "S2_scheduled_engine": {
    "context": { "action": "context", "demo_id": "YOUR_COCKPIT_SESSION_UUID" },
    "live_mode_filter": "context.mode equals live",
    "poll": { "action": "poll", "demo_id": "YOUR_COCKPIT_SESSION_UUID", "generation": "{{context.generation: map as a JSON number}}" },
    "reconciliation": { "action": "reconciliation", "demo_id": "YOUR_COCKPIT_SESSION_UUID", "generation": "{{context.generation: map as a JSON number}}" },
    "condition": { "action": "condition", "demo_id": "YOUR_COCKPIT_SESSION_UUID", "generation": "{{context.generation: map as a JSON number}}" },
    "retry": { "action": "retry", "demo_id": "YOUR_COCKPIT_SESSION_UUID", "generation": "{{context.generation: map as a JSON number}}" }
  }
}
