# Server-only configuration. Set these in Vercel, or export for scripts/serve-demo.js.
# Never copy these into public/config.js. This file contains placeholders only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
DEMO_PRESENTER_TOKEN=replace-with-a-long-random-rehearsal-token
MAKE_AUTOMATION_TOKEN=replace-with-a-different-long-random-callback-token
MAKE_PAYMENT_WEBHOOK_URL=https://hook.your-make-zone.make.com/replace
# Use this same fixed UUID in all five S2 scheduled-engine modules.
MAKE_DEMO_SESSION_ID=00000000-0000-4000-8000-000000000001

# Optional panel Run scheduled checks support. Only configure if your Make plan allows API access.
# S1 webhook delivery and S2 schedules/Run once do not require these values.
MAKE_API_BASE_URL=https://eu1.make.com/api/v2
MAKE_API_TOKEN=replace-with-server-only-make-api-token
MAKE_SCHEDULED_SCENARIO_ID=123
